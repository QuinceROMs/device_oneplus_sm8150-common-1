# Zram
ro.zram.first_wb_delay_mins=1440
ro.zram.mark_idle_delay_mins=60
ro.zram.periodic_wb_delay_hours=24

# IO Prefetcher
vendor.iop.enable_uxe=1

# Bluetooth
bluetooth.afh.min_good_channels=20
bluetooth.channel_quality_monitoring=1
bluetooth.error_correction.fec_level=3
bluetooth.interleaving.bit_level=1
bluetooth.le.connection_interval_max=30
bluetooth.le.connection_interval_min=15
bluetooth.le.fast_reconnect=1
bluetooth.le.subrating_factor=4
bluetooth.packet_recovery.adaptive=1
bluetooth.transmission.robustness=enhanced
ro.bluetooth.afh_channel_classification=ai_enabled

# Radio
persist.radio.ca_bw_scaling=1
persist.radio.ca_combine_rats=1-3-5-7-8-20-28-38-40-41
persist.radio.volte_emergency_support=1
persist.vendor.radio.enable_reporting_criteria=1
persist.vendor.radio.iccr_enabled=1
ro.radio.iccr_profile=urban
ro.telephony.dynamic_rat_combine=true
ro.telephony.max_ca_num=5
ro.telephony.mimo_4x4_supported=1
ro.telephony.power_profile=balanced
ro.telephony.signal_strength.lte_measurement=rsrp,rsrq,rssnr
ro.telephony.signal_strength.use_rsrp=true
